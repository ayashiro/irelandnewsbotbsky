# Required: Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Required (unless --dry-run): Bluesky credentials
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional settings
GEMINI_MODEL=gemini-4-hydrogen
TIMEZONE=Europe/Dublin
POST_HASHTAGS=#アイルランドニュース #アイルランド
# RSS_FEEDS=https://www.met.ie/warningsxml/rss.xml,https://www.rte.ie/feeds/rss/?index=/news/ireland/,https://www.rte.ie/feeds/rss/?index=/news/dublin/,https://www.breakingnews.ie/feed/ireland.rss,https://www.thejournal.ie/feed/,https://www.dublinlive.ie/news/?service=rss
